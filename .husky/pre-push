#!/usr/bin/env sh
# .husky/pre-push
# 推送前钩子：密钥扫描 + 快速门禁（typecheck + lint + scripts 测试）
#
# 设计：
# - 密钥扫描：gitleaks dir 全量扫描工作目录，与 pre-commit 的 protect --staged 互补
#   （pre-commit 只检查暂存区，pre-push 检查已提交+工作区全量，防绕过）
# - 全量测试（unit/e2e）由 CI 覆盖，本地推送只跑秒级快速门禁
# - typecheck：增量编译，防止带类型错误推送
# - lint：全量 Biome 检查（含格式/import 排序）
# - test:scripts：脚手架纯函数测试（秒级）
# - 用户可设 SKIP_PREPUSH=1 完全跳过（紧急推送时）
#
# 注意：与 pre-commit（lint-staged 只检查暂存区）互补，
# pre-push 检查工作区全量状态，防"暂存区通过但工作区带错"推送

if [ "$SKIP_PREPUSH" = "1" ]; then
  echo "[pre-push] SKIP_PREPUSH=1，跳过快速门禁"
  exit 0
fi

echo "[pre-push] 运行密钥扫描 + 快速门禁（typecheck + lint + test:scripts）..."

# 密钥扫描（gitleaks 业界标准；未安装时跳过并提示）
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks dir . --redact --no-banner || exit 1
else
  echo "[pre-push] gitleaks 未安装，跳过密钥扫描"
fi

pnpm typecheck || exit 1
pnpm lint || exit 1
pnpm check:static || exit 1
pnpm depcruise || exit 1
pnpm test:scripts || exit 1

echo "[pre-push] 快速门禁通过 ✓"
