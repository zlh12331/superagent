# 环境变量模板（Code Agent Desktop）
# ──────────────────────────────────────────────────────────────
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# .env 已在 .gitignore 中忽略，不会提交到仓库。
#
# 说明：
# - 所有配置项均为可选，未配置时使用代码内默认值
# - API Key 不通过 .env 管理（走应用内 safeStorage 加密存储），
#   但可用 .env 提供默认值便于 CI / 自动化场景
# ──────────────────────────────────────────────────────────────

# ── AI Provider（多供应商路由，全部可选） ─────────────────────
# DeepSeek（默认供应商，OpenAI Compatible 协议）
# DEEPSEEK_API_BASE="https://api.deepseek.com"

# OpenAI
# OPENAI_API_BASE="https://api.openai.com/v1"

# Anthropic Claude
# ANTHROPIC_API_BASE="https://api.anthropic.com"

# Ollama 本地模型（无需 API Key）
# OLLAMA_API_BASE="http://localhost:11434"
# MOONSHOT_API_BASE="https://api.moonshot.cn/v1"
# ZHIPU_API_BASE="https://open.bigmodel.cn/api/paas/v4"
# QWEN_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
# DOUBAO_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
# SILICONFLOW_API_BASE="https://api.siliconflow.cn/v1"
# OPENROUTER_API_BASE="https://openrouter.ai/api/v1"


# ── 日志级别（debug / info / warn / error） ──────────────────
# LOG_LEVEL="info"

# ── Sentry 自托管配置（可选，DSN 为空则跳过初始化） ────────────
# DSN 格式：http://<public_key>@<host>:<port>/<project_id>
# SENTRY_DSN="http://<public_key>@127.0.0.1:9000/<project_id>"
# 性能事务采样率（0-1，开发环境推荐 1.0 全量采集）
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ── Sentry CLI（符号上传用，需配合 sentry.properties） ────────
# SENTRY_URL="http://127.0.0.1:9000"
# SENTRY_ORG="sentry"
# SENTRY_PROJECT="electron"
# sentry-cli 认证令牌（在 Sentry UI → Settings → API Keys 生成）
# 权限：org:read, project:releases, project:write
# 警告：不要将真实 token 提交到仓库，仅放入 .env
# SENTRY_AUTH_TOKEN=""

# ── OpenTelemetry（可选，未配置 OTLP 端点时退化为 Console exporter） ──
# OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
