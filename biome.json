{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/resources/pg",
      "!**/release",
      "!**/coverage",
      "!**/node_modules",
      "!**/out",
      "!**/dist",
      "!**/.codegraph",
      "!**/playwright-report",
      "!**/test-results",
      "!**/playwright/.cache",
      "!**/docs/design",
      "!**/docs/参考项目",
      "!**/prototype-v2.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "warn"
      },
      "style": {
        "useImportType": "error",
        "useNamingConvention": "error",
        "useConst": "error",
        "noDefaultExport": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/src/renderer/**/*.tsx"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": ["**/commitlint.config.js"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": [
        "**/packages/shared/src/constants/errors.ts",
        "**/packages/shared/src/constants/pg-versions.ts",
        "**/packages/shared/src/constants/age.ts",
        "**/packages/shared/src/types/enums.ts",
        "**/packages/shared/src/ipc/channels.ts",
        "**/src/renderer/lib/constants.ts"
      ],
      "linter": {
        "rules": {
          "style": { "useNamingConvention": "off" }
        }
      }
    },
    {
      "includes": ["**/prisma.config.ts"],
      "linter": {
        "rules": {
          "style": { "noDefaultExport": "off" }
        }
      }
    },
    {
      "includes": [
        "**/packages/shared/src/types/models.ts",
        "**/packages/shared/src/ipc/response.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    },
    {
      "includes": ["**/packages/shared/src/ipc/payloads.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/ai/ai-provider.ts",
        "**/src/main/infra/ai/error-classifier.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/main/__tests__/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/ai/chat-service.ts",
        "**/src/main/app/service-container.ts",
        "**/src/main/ipc/chat.handler.ts",
        "**/src/main/ipc/file.handler.ts",
        "**/src/main/ipc/search.handler.ts",
        "**/src/main/infra/file/file-service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/search/search-service.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/agent/tool.ts",
        "**/src/main/infra/agent/permission-service.ts",
        "**/src/main/infra/agent/tool-registry.ts",
        "**/src/main/infra/agent/tool-executor.ts",
        "**/src/main/infra/agent/agent-service.ts",
        "**/src/main/infra/agent/tools/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/renderer/stores/persistent/create-persistent-store.ts",
        "**/src/renderer/stores/server/create-ipc-stream-store.ts",
        "**/src/renderer/i18n/config.ts",
        "**/src/renderer/i18n/use-translation.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": { "strictCase": false }
            }
          }
        }
      }
    },
    {
      "includes": ["**/tests/integration/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/playwright.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
