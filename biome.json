{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/resources/pg",
      "!**/third_party",
      "!**/release",
      "!**/coverage*",
      "!**/node_modules",
      "!**/out",
      "!**/dist",
      "!**/drizzle",
      "!**/.codegraph",
      "!**/playwright-report",
      "!**/playwright-report-electron",
      "!**/playwright-report-smoke",
      "!**/test-results",
      "!**/styles/tokens.css",
      "!**/tokens",
      "!**/playwright/.cache",
      "!**/docs/design",
      "!**/docs/参考项目",
      "!**/prototype-v2.html",
      "!**/codex-desktop-prototype.design",
      "!**/.design",
      "!_template"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "useAltText": "error",
        "useButtonType": "error",
        "useValidAriaValues": "error",
        "noAriaHiddenOnFocusable": "error",
        "useHeadingContent": "error",
        "useFocusableInteractive": "error",
        "useSemanticElements": "warn"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn",
        "noUndeclaredVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noDeprecatedImports": "error"
      },
      "style": {
        "useImportType": "error",
        "useNamingConvention": "error",
        "useConst": "error",
        "noDefaultExport": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case", "export"] }
        }
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noUselessReturn": "error",
        "noUselessCatchBinding": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["kebab-case", "PascalCase", "export"] }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/renderer/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/commitlint.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/shared/src/constants/errors.ts",
        "**/packages/shared/src/ipc/channels.ts",
        "**/packages/shared/src/schemas/agent-events.ts",
        "**/packages/shared/src/schemas/im.ts",
        "**/packages/shared/src/schemas/goal.ts",
        "**/src/main/infra/im/**",
        "**/src/main/infra/remote/**",
        "**/src/main/infra/ai/agent/hook-registry.ts",
        "**/src/main/infra/ai/agent/task-service.ts",
        "**/src/main/infra/ai/agent/agent-service.ts",
        "**/src/main/infra/ai/agent/chat-service.ts",
        "**/src/main/infra/ai/agent/workflow-service.ts",
        "**/src/main/infra/ai/knowledge/session-title.ts",
        "**/src/main/infra/ai/llm-client/ai-provider.ts",
        "**/src/main/infra/code-analysis/code-analyzer.ts",
        "**/src/renderer/lib/constants.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/prisma.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/drizzle.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/i18next.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/shared/src/types/models.ts",
        "**/packages/shared/src/ipc/response.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/packages/shared/src/ipc/payloads.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/main/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/service-container.ts",
        "**/src/main/ipc/chat.handler.ts",
        "**/src/main/ipc/codebase.handler.ts",
        "**/src/main/ipc/file.handler.ts",
        "**/src/main/ipc/search.handler.ts",
        "**/src/main/ipc/terminal.handler.ts",
        "**/src/main/ipc/git.handler.ts",
        "**/src/main/ipc/session.handler.ts",
        "**/src/main/infra/codebase/codebase-service.ts",
        "**/src/main/infra/file/file-service.ts",
        "**/src/main/infra/terminal/terminal-service.ts",
        "**/src/main/infra/git/git-service.ts",
        "**/src/main/infra/storage/db.ts",
        "**/src/main/infra/storage/schema.ts",
        "**/src/main/infra/storage/session-service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/search/search-service.ts",
        "**/src/main/infra/search/search-service.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/ai/tools/**/*.ts",
        "**/src/main/infra/ai/mcp/**/*.ts",
        "**/src/main/infra/ai/prompt/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/ai/providers/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/renderer/stores/persistent/create-persistent-store.ts",
        "**/src/renderer/i18n/config.ts",
        "**/src/renderer/i18n/use-translation.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/renderer/components/chat/**/*.tsx",
        "**/src/renderer/components/agent/**/*.tsx",
        "**/src/renderer/lib/chat/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/tests/integration/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.perf.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/e2e/playwright.config.ts",
        "**/e2e/playwright.electron.config.ts",
        "**/e2e/playwright.smoke.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/.github/workflows/*.yml"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/.nsprc"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**/*.ts", "**/scripts/**/*.mjs", "**/scripts/**/*.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/im/adapters/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/renderer/index.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noInnerDeclarations": "off"
          },
          "complexity": {
            "useArrowFunction": "off"
          }
        }
      }
    }
  ]
}
