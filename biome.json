{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/resources/pg",
      "!**/release",
      "!**/coverage",
      "!**/node_modules",
      "!**/out",
      "!**/dist",
      "!**/.codegraph",
      "!**/playwright-report",
      "!**/playwright-report-electron",
      "!**/playwright-report-smoke",
      "!**/test-results",
      "!**/playwright/.cache",
      "!**/docs/design",
      "!**/docs/参考项目",
      "!**/prototype-v2.html",
      "!**/codex-desktop-prototype.design",
      "!_template"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "warn"
      },
      "style": {
        "useImportType": "error",
        "useNamingConvention": "error",
        "useConst": "error",
        "noDefaultExport": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/src/renderer/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/commitlint.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/shared/src/constants/errors.ts",
        "**/packages/shared/src/constants/pg-versions.ts",
        "**/packages/shared/src/constants/age.ts",
        "**/packages/shared/src/types/enums.ts",
        "**/packages/shared/src/ipc/channels.ts",
        "**/packages/shared/src/schemas/agent-events.ts",
        "**/packages/shared/src/schemas/im.ts",
        "**/packages/shared/src/schemas/goal.ts",
        "**/src/main/infra/im/**",
        "**/src/main/infra/remote/**",
        "**/src/main/infra/ai/hook-registry.ts",
        "**/src/main/infra/ai/task-service.ts",
        "**/src/renderer/lib/constants.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/prisma.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/drizzle.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/shared/src/types/models.ts",
        "**/packages/shared/src/ipc/response.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/packages/shared/src/ipc/payloads.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/ai/ai-provider.ts",
        "**/src/main/infra/ai/error-classifier.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/main/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/ai/chat-service.ts",
        "**/src/main/infra/ai/session-title.ts",
        "**/src/main/service-container.ts",
        "**/src/main/ipc/chat.handler.ts",
        "**/src/main/ipc/codebase.handler.ts",
        "**/src/main/ipc/file.handler.ts",
        "**/src/main/ipc/search.handler.ts",
        "**/src/main/ipc/terminal.handler.ts",
        "**/src/main/ipc/git.handler.ts",
        "**/src/main/ipc/session.handler.ts",
        "**/src/main/infra/codebase/codebase-service.ts",
        "**/src/main/infra/file/file-service.ts",
        "**/src/main/infra/terminal/terminal-service.ts",
        "**/src/main/infra/git/git-service.ts",
        "**/src/main/infra/storage/db.ts",
        "**/src/main/infra/storage/schema.ts",
        "**/src/main/infra/storage/session-service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/search/search-service.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/code/code-analyzer.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/src/main/infra/ai/tool.ts",
        "**/src/main/infra/ai/permission-service.ts",
        "**/src/main/infra/ai/tool-registry.ts",
        "**/src/main/infra/ai/tool-executor.ts",
        "**/src/main/infra/ai/agent-service.ts",
        "**/src/main/infra/ai/tools/**/*.ts",
        "**/src/main/infra/ai/mcp/**/*.ts",
        "**/src/main/infra/ai/prompt/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/ai/providers/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/renderer/stores/persistent/create-persistent-store.ts",
        "**/src/renderer/stores/server/create-ipc-stream-store.ts",
        "**/src/renderer/i18n/config.ts",
        "**/src/renderer/i18n/use-translation.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/src/renderer/components/chat/**/*.tsx",
        "**/src/renderer/components/agent/**/*.tsx",
        "**/src/renderer/hooks/use-chat.ts",
        "**/src/renderer/lib/chat/**/*.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/tests/integration/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/e2e/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/e2e/playwright.config.ts",
        "**/e2e/playwright.electron.config.ts",
        "**/e2e/playwright.smoke.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/.github/workflows/*.yml"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/.nsprc"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**/*.ts", "**/scripts/**/*.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/ai/workflow-service.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["**/src/main/infra/im/adapters/webhook-channels.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
