{
  "name": "novel-writer-agent",
  "version": "0.1.0",
  "description": "网文写作 Agent - Windows 桌面端应用",
  "author": "novel-writer",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --filter \"@novel-writer/*\" run test && pnpm test:main",
    "test:main": "vitest run --root src/main",
    "test:integration": "vitest run --root tests/integration",
    "test:e2e": "cross-env E2E_MODE=true playwright test --config e2e/playwright.config.ts",
    "test:coverage": "pnpm --filter \"@novel-writer/shared\" exec vitest run --coverage && pnpm test:main -- --coverage",
    "db:generate": "prisma generate",
    "db:migrate:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "build:dist": "pnpm build && electron-builder --publish never",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "download:pg": "tsx scripts/download-pg.ts",
    "codegraph:sync": "codegraph sync",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@novel-writer/shared": "workspace:*",
    "@novel-writer/tsconfig": "workspace:*",
    "@playwright/test": "^1.58",
    "@testcontainers/postgresql": "^11",
    "@types/node": "^24",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7",
    "dotenv": "^16",
    "electron": "^40",
    "electron-builder": "^26",
    "husky": "^9",
    "lint-staged": "^15",
    "prisma": "^7",
    "testcontainers": "^11",
    "tsx": "^4",
    "typescript": "^6",
    "vitest": "^4.0.0",
    "wait-on": "^8"
  },
  "dependencies": {
    "@prisma/client": "^7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sentry/electron": "^5",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5",
    "@tiptap/extension-character-count": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5",
    "electron-vite": "6.0.0-beta.1",
    "lucide-react": "^1.25.0",
    "next-themes": "^0.4.6",
    "openai": "^5",
    "pdf-parse": "^2.4.5",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-router": "^7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8",
    "zod": "^4.0.0",
    "zustand": "^5"
  }
}
