{
  "name": "code-agent-desktop",
  "version": "1.0.0",
  "description": "Code Agent Desktop - 生产级 Electron Code Agent 模板（Windows 桌面端）",
  "author": "code-agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ],
    "packageExtensions": {
      "dependency-cruiser": {
        "peerDependencies": {
          "typescript": "*"
        },
        "peerDependenciesMeta": {
          "typescript": {
            "optional": true
          }
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-rebuild.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip --include files,dependencies,devDependencies,binaries",
    "depcruise": "pnpm --filter @code-agent/depcruise run check",
    "changelog": "tsx scripts/changelog/changelog-gen.ts",
    "format": "biome format --write .",
    "test": "pnpm -r --filter \"@code-agent/*\" --filter \"!@code-agent/typedoc-docs\" run test && pnpm test:main && pnpm test:renderer && pnpm test:scripts",
    "test:scripts": "vitest run --root scripts",
    "test:main": "vitest run --root src/main",
    "test:main:watch": "vitest --root src/main",
    "test:renderer": "vitest run --root src/renderer",
    "test:renderer:watch": "vitest --root src/renderer",
    "test:e2e": "cross-env E2E_MODE=true playwright test --config e2e/playwright.config.ts",
    "test:e2e:electron": "playwright test --config e2e/playwright.electron.config.ts",
    "test:smoke": "playwright test --config e2e/playwright.smoke.config.ts",
    "test:visual": "playwright test --config e2e/playwright.config.ts --grep \"视觉回归\"",
    "test:a11y": "playwright test --config e2e/playwright.config.ts --grep \"可访问性\"",
    "test:perf": "playwright test --config e2e/playwright.config.ts --grep \"性能基准\"",
    "test:coverage": "pnpm --filter \"@code-agent/shared\" exec vitest run --coverage && pnpm test:main -- --coverage && pnpm test:renderer -- --coverage",
    "audit": "audit-ci --config .nsprc --moderate --high --critical --report-type summary --registry https://registry.npmjs.org",
    "build:dist": "pnpm build && electron-builder --publish never",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "sentry:upload:symbols": "sentry-cli sourcemaps upload --org sentry --project electron --release \"code-agent@1.0.0\" --url-prefix \"app:///out/\" ./out && sentry-cli sourcemaps upload --org sentry --project electron --release \"code-agent@1.0.0\" --url-prefix \"app:///renderer/\" ./out/renderer",
    "sentry:release:new": "sentry-cli releases new \"code-agent@1.0.0\"",
    "build:win:full": "pnpm build:win && pnpm sentry:release:new && pnpm sentry:upload:symbols",
    "codegraph:sync": "codegraph sync",
    "scaffold:ipc": "tsx scripts/scaffold/scaffold-ipc.ts",
    "scaffold:tool": "tsx scripts/scaffold/scaffold-tool.ts",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "analyze:bundle": "cross-env ANALYZE_BUNDLE=1 pnpm build",
    "docs:types": "pnpm --filter @code-agent/typedoc-docs run gen",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2",
    "@changesets/cli": "^2.31.1",
    "@code-agent/shared": "workspace:*",
    "@code-agent/tsconfig": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.58",
    "@sentry/cli": "^2.41.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.0",
    "audit-ci": "^7.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "6.0.0-beta.1",
    "husky": "^9",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "lint-staged": "^17.1.0",
    "playwright": "^1.61.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/openai-compatible": "^3.0.13",
    "@ai-sdk/react": "^4.0.35",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@sentry/electron": "^7.15.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.32",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff-match-patch": "^1.0.5",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "node-pty": "^1.1.0",
    "react": "^19.2",
    "react-arborist": "^3.15.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.2",
    "react-error-boundary": "^6.1.2",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-virtuoso": "^4.18.11",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  }
}
