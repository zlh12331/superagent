{
  "name": "novel-writer-agent",
  "version": "0.1.0",
  "description": "网文写作 Agent - Windows 桌面端应用",
  "author": "novel-writer",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty"
    ]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r --filter \"@novel-writer/*\" run test && pnpm test:main",
    "test:main": "vitest run --root src/main",
    "test:e2e": "cross-env E2E_MODE=true playwright test --config e2e/playwright.config.ts",
    "test:coverage": "pnpm --filter \"@novel-writer/shared\" exec vitest run --coverage && pnpm test:main -- --coverage",
    "build:dist": "pnpm build && electron-builder --publish never",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "codegraph:sync": "codegraph sync",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/rebuild": "^4.2.0",
    "@novel-writer/shared": "workspace:*",
    "@novel-writer/tsconfig": "workspace:*",
    "@playwright/test": "^1.58",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.1.1",
    "electron-builder": "^26",
    "husky": "^9",
    "lint-staged": "^17.1.0",
    "tsx": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.13",
    "@ai-sdk/react": "^4.0.35",
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@sentry/electron": "^7.15.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.3",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.32",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff-match-patch": "^1.0.5",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5",
    "electron-updater": "^6.8.9",
    "electron-vite": "6.0.0-beta.1",
    "fuse.js": "^7.5.0",
    "gpt-tokenizer": "^3.4.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "node-pty": "^1.1.0",
    "react": "^19.2",
    "react-arborist": "^3.15.0",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.2",
    "react-error-boundary": "^6.1.2",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "react-virtuoso": "^4.18.11",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8",
    "web-tree-sitter": "^0.26.11",
    "zod": "^4.0.0",
    "zustand": "^5.0.14"
  }
}
