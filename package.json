{
  "name": "code-agent-desktop",
  "version": "0.0.0",
  "description": "Code Agent Desktop - 生产级 Electron Code Agent 桌面应用（Windows 桌面端）",
  "author": "code-agent",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall-rebuild.mjs",
    "dev": "electron-vite dev -w",
    "dev:web": "vite --config vite.web.config.ts --mode web",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --build",
    "typecheck:watch": "tsc --build --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip --include files,dependencies,devDependencies,binaries",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:i18n": "tsx scripts/check-i18n.ts --strict",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:compiler": "tsx scripts/check-compiler.ts",
    "check:static": "pnpm check:tokens && pnpm check:i18n && pnpm check:comments && pnpm check:file-size && pnpm check:functions && pnpm check:coverage-floors && pnpm check:docs && pnpm check:test-boundary && pnpm check:csp-hash && pnpm check:ui-consistency",
    "check:csp-hash": "tsx scripts/check-csp-hash.ts",
    "check:ui-consistency": "tsx scripts/check-ui-consistency.ts",
    "check:secrets": "gitleaks dir src --redact --no-banner",
    "check:coverage-floors": "tsx scripts/check-coverage-floors.ts",
    "coverage-floors:tighten": "tsx scripts/check-coverage-floors.ts --tighten",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs && git diff --exit-code -- src/renderer/styles/tokens.css",
    "i18n:status": "i18next-cli status",
    "i18n:lint": "i18next-cli lint",
    "check:docs": "pnpm --filter @code-agent/typedoc-docs run check",
    "check:file-size": "tsx scripts/check-file-size.ts",
    "check:functions": "tsx scripts/check-functions.ts",
    "check:comments": "tsx scripts/check-comments.ts",
    "depcruise": "pnpm --filter @code-agent/depcruise run check",
    "format": "biome format --write .",
    "test": "pnpm -r --filter \"@code-agent/*\" --filter \"!@code-agent/typedoc-docs\" run test && pnpm test:main && pnpm test:renderer && pnpm test:integration && pnpm test:scripts",
    "test:scripts": "vitest run --root scripts",
    "test:main": "vitest run --root src/main",
    "test:main:watch": "vitest --root src/main",
    "test:renderer": "vitest run --root src/renderer",
    "test:renderer:watch": "vitest --root src/renderer",
    "test:e2e": "cross-env E2E_MODE=true playwright test --config e2e/playwright.config.ts",
    "test:e2e:electron": "playwright test --config e2e/playwright.electron.config.ts",
    "test:smoke": "playwright test --config e2e/playwright.smoke.config.ts",
    "test:visual": "playwright test --config e2e/playwright.config.ts --grep \"视觉回归\"",
    "test:a11y": "playwright test --config e2e/playwright.config.ts --grep \"可访问性\"",
    "test:perf": "playwright test --config e2e/playwright.config.ts --grep \"性能基准|渲染性能基准|内存基准|IPC 基准\"",
    "test:perf:main": "vitest run --root src/main --config vitest.perf.config.ts",
    "perf:inspect": "electron --inspect=9229 .",
    "test:perf:electron": "playwright test --config e2e/playwright.electron.config.ts --grep \"性能基准\"",
    "test:coverage": "pnpm --filter \"@code-agent/shared\" exec vitest run --coverage && pnpm test:main --coverage && pnpm test:renderer --coverage",
    "audit": "audit-ci --config .nsprc --moderate --high --critical --report-type summary --registry https://registry.npmjs.org",
    "prepare:memory-hub": "node scripts/prepare-memory-hub.mjs",
    "prepare:codegraph": "node scripts/prepare-codegraph.mjs",
    "prepare:build-info": "node scripts/generate-build-info.mjs",
    "build:dist": "pnpm prepare:build-info && pnpm prepare:memory-hub && pnpm prepare:codegraph && pnpm build && electron-builder --publish never",
    "build:win": "pnpm prepare:build-info && pnpm prepare:memory-hub && pnpm prepare:codegraph && pnpm build && electron-builder --win --publish never",
    "build:mac": "pnpm prepare:build-info && pnpm prepare:memory-hub && pnpm prepare:codegraph && pnpm build && electron-builder --mac --publish never",
    "build:linux": "pnpm prepare:build-info && pnpm prepare:memory-hub && pnpm prepare:codegraph && pnpm build && electron-builder --linux --publish never",
    "build:all": "pnpm prepare:build-info && pnpm prepare:memory-hub && pnpm prepare:codegraph && pnpm build && electron-builder --publish never",
    "sentry:upload:symbols": "node scripts/sentry-release.mjs upload",
    "sentry:release:new": "node scripts/sentry-release.mjs new",
    "build:win:full": "pnpm build:win && pnpm sentry:release:new && pnpm sentry:upload:symbols",
    "codegraph:sync": "codegraph sync",
    "scaffold:ipc": "tsx scripts/scaffold/scaffold-ipc.ts",
    "scaffold:tool": "tsx scripts/scaffold/scaffold-tool.ts",
    "analyze:bundle": "cross-env ANALYZE_BUNDLE=1 pnpm build",
    "docs:types": "pnpm --filter @code-agent/typedoc-docs run gen",
    "prepare": "husky",
    "test:integration": "vitest run --root tests/integration",
    "check:test-boundary": "tsx scripts/check-test-boundary.ts",
    "sbom:generate": "cdxgen -t pnpm --spec-version 1.6 -o bom.json"
  },
  "lint-staged": {
    "{src,scripts,packages,tools,e2e,tests}/**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@ai-sdk/react": "^4.0.95",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@code-agent/shared": "workspace:*",
    "@code-agent/tsconfig": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@cyclonedx/cdxgen": "^12.8.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron/rebuild": "^4.2.0",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.62.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/cli": "^3.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "audit-ci": "^7.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^10.1.0",
    "diff-match-patch": "^1.0.5",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "6.0.0-beta.1",
    "fuse.js": "^7.5.0",
    "husky": "^9.1.7",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-cli": "^1.73.0",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "oxc-transform-react": "^0.148.0",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-activity-calendar": "^3.2.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.1",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "style-dictionary": "^5.5.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@colbymchenry/codegraph": "^1.6.0",
    "@cursorless/tree-sitter-wasms": "^0.10.0",
    "@larksuiteoapi/node-sdk": "^1.73.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@sentry/electron": "^7.18.0",
    "@vscode/ripgrep": "^1.18.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.92",
    "better-sqlite3": "^13.0.3",
    "chardet": "^2.2.0",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gpt-tokenizer": "^4.0.0",
    "iconv-lite": "^0.7.3",
    "node-pty": "^1.1.0",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.27.0",
    "xstate": "^5.32.6",
    "zod": "^4.5.4"
  }
}
