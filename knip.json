{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/renderer/index.html",
        "src/renderer/test/setup.ts",
        "src/renderer/test/setup-lang.ts",
        "src/**/*.test.{ts,tsx}",
        "**/vitest.config.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "*.config.{js,ts}",
        ".husky/pre-commit",
        ".husky/pre-push"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "src/**/*.css",
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "*.{ts,js}",
        "!vitest.workspace.ts"
      ]
    }
  },
  "ignoreBinaries": ["codegraph", "pkill", "gitleaks"],
  "ignoreDependencies": ["@code-agent/tsconfig", "@electron/rebuild", "tslib", "tree-sitter-wasms"]
}
