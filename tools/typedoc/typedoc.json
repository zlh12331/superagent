{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "../../packages/shared/src/index.ts",
    "../../packages/shared/src/main.ts",
    "../../packages/shared/src/preload.ts",
    "../../packages/shared/src/renderer.ts"
  ],
  "out": "../../docs/api",
  "tsconfig": "../../packages/shared/tsconfig.json",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "excludeInternal": true,
  "readme": "none",
  "disableSources": true,
  "validation": { "notDocumented": false, "notExported": false },
  "githubPages": false,
  "name": "Code Agent Desktop - Shared 类型契约"
}
