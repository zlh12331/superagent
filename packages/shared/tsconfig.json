{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@novel-writer/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": ["vitest/globals"],
    "isolatedDeclarations": false
  },
  "include": ["src/**/*.ts"]
}
