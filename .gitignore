# .gitignore

# 依赖
node_modules/
# pnpm 本地内容寻址存储（沙箱/无全局 store 环境安装时生成）
.pnpm-store/
# TRAE 本地工具产物（会话文档等，不入仓）
.trae/

# 构建产物
dist/
out/
release/
*.tsbuildinfo
# SBOM 生成产物（cdxgen 输出到根目录，release 归档副本在 release/ 已忽略）
bom.json

# electron-vite 临时
.vite/
# 工具运行时状态（钩子会话锁等机器生成文件）
.mimosa/
.mimocode/
# AI 代码评审插件历史状态（本地审计存档，不入仓）
.brooks-lint-history.json

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/project.code-snippets
!.vscode/README.md
.idea/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.local
.env.*.local

# 日志
*.log
logs/

# CodeGraph 索引（已存在 .codegraph/.gitignore 自管）
# 测试覆盖率
coverage/

# 包体积分析产物（pnpm analyze:bundle 生成，按需分析不入仓）
stats/

# TypeDoc 生成的 API 文档（pnpm docs:types 按需生成，不入仓）
docs/api/

# Playwright 测试产物（trace / report / 截图 / 视频）
playwright-report/
playwright-report-electron/
playwright-report-smoke/
playwright/.cache/
test-results/

# Playwright 视觉回归基线图（首次生成后提交到仓库，不忽略）
# e2e/visual.spec.ts-snapshots/ 需要提交以做 diff 基线
# 但本地更新产生的临时 diff 产物可忽略
test-results-visual/

# Electron 二进制下载缓存（dev 环境用，避免 TRAE 沙箱拦截系统 %LOCALAPPDATA%）
.electron-cache/
# Electron userData 目录（dev 环境重定向到此，避免 TRAE 沙箱拦截系统 %APPDATA%）
.electron-user-data/
# E2E Electron 测试专用 userData（多实例隔离）
.e2e-user-data/
# dev 更新链路 E2E 专用 userData（electron-update-dev.spec.ts）
.e2e-user-data-update/

# Electron 打包
*.exe
*.appx
*.msi

# PostgreSQL 便携版二进制（由 scripts/download-pg.ts 下载，约 200MB/版本，不入仓）
# 设计文档 §6.5：resources/pg/18.4 + resources/pg/17.10 双版本
resources/pg/

# PG 下载脚本的临时目录（zip + 解压目录，盘符内同盘移动避免 EXDEV）
.tmp/

# 记忆引擎运行目录（由 scripts/prepare-memory-hub.mjs 从仓库内源码生成）
# 体积大（含 node_modules），不入仓；打包前执行 pnpm prepare:memory-hub 生成
# 注：引擎源码已 vendored 进仓（packages/memory-engine/MemoryCore），此处仅构建产物
resources/memory-hub/
# codegraph 平台捆绑包（vendored Node 24 + app，体积大），由 scripts/prepare-codegraph.mjs 生成
resources/codegraph/

# 上游 MemoryCore 源码压缩包（本地参考，不入仓；源码已 vendored 至 packages/memory-engine）
docs/TencentDB-Agent-Memory-*.zip

# electron-builder 打包产物（NSIS 安装包、latest.yml 等）
release/

# Qoder 工具缓存（repowiki 索引等，运行时自动生成，不入仓）
.qoder/

# 根目录临时调试脚本与一次性诊断输出（历史遗留，不入仓）
/check-encoding.ps1
/convert_crlf.py
/diag.txt
/feishu_doc.txt
/fix_platform_toolset.py
/lint_output.txt
/lint_output2.txt
/rebuild-node-pty.ps1
/rebuild-node-pty-step2.ps1

# AI 会话生成的临时图片素材（不入仓）
/vibe_images/
