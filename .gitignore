# .gitignore

# 依赖
node_modules/
# pnpm 本地内容寻址存储（沙箱/无全局 store 环境安装时生成）
.pnpm-store/

# 构建产物
dist/
out/
release/
*.tsbuildinfo

# electron-vite 临时
.vite/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/project.code-snippets
!.vscode/README.md
.idea/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.local
.env.*.local

# 日志
*.log
logs/

# CodeGraph 索引（已存在 .codegraph/.gitignore 自管）
# 测试覆盖率
coverage/

# 包体积分析产物（pnpm analyze:bundle 生成，按需分析不入仓）
stats/

# TypeDoc 生成的 API 文档（pnpm docs:types 按需生成，不入仓）
docs/api/

# Playwright 测试产物（trace / report / 截图 / 视频）
playwright-report/
playwright-report-electron/
playwright-report-smoke/
playwright/.cache/
test-results/

# Playwright 视觉回归基线图（首次生成后提交到仓库，不忽略）
# e2e/visual.spec.ts-snapshots/ 需要提交以做 diff 基线
# 但本地更新产生的临时 diff 产物可忽略
test-results-visual/

# Electron 二进制下载缓存（dev 环境用，避免 TRAE 沙箱拦截系统 %LOCALAPPDATA%）
.electron-cache/
# Electron userData 目录（dev 环境重定向到此，避免 TRAE 沙箱拦截系统 %APPDATA%）
.electron-user-data/
# E2E Electron 测试专用 userData（多实例隔离）
.e2e-user-data/

# Electron 打包
*.exe
*.appx
*.msi

# PostgreSQL 便携版二进制（由 scripts/download-pg.ts 下载，约 200MB/版本，不入仓）
# 设计文档 §6.5：resources/pg/18.4 + resources/pg/17.10 双版本
resources/pg/

# PG 下载脚本的临时目录（zip + 解压目录，盘符内同盘移动避免 EXDEV）
.tmp/

# 记忆引擎运行目录（TencentDB-Agent-Memory · MemoryCore，由 scripts/prepare-memory-hub.mjs 生成）
# 体积大（含 node_modules），不入仓；打包前执行 pnpm prepare:memory-hub 生成
resources/memory-hub/
# codegraph 平台捆绑包（vendored Node 24 + app，体积大），由 scripts/prepare-codegraph.mjs 生成
resources/codegraph/

# 上游 MemoryCore 源码压缩包（本地参考，不入仓；源码已复制进 resources/memory-hub）
docs/TencentDB-Agent-Memory-2.0.1-beta.2.zip

# electron-builder 打包产物（NSIS 安装包、latest.yml 等）
release/

# 原型设计文件（仅本地参考，不入仓）
# P2-9：prototype-v2.html 已从根目录移入 docs/prototype/，避免污染项目根
docs/prototype/

# Qoder 工具缓存（repowiki 索引等，运行时自动生成，不入仓）
.qoder/

# 根目录临时调试脚本与一次性诊断输出（历史遗留，不入仓）
/check-encoding.ps1
/convert_crlf.py
/diag.txt
/feishu_doc.txt
/fix_platform_toolset.py
/lint_output.txt
/lint_output2.txt
/rebuild-node-pty.ps1
/rebuild-node-pty-step2.ps1

# 本地模板/原型参考资产（含运行时产物与 .env，不入仓）
/_template/
/codex-desktop-prototype.design/

# 外部参考代码（docs/参考项目/，含 node_modules 约 2.6GB，不入仓）
/docs/参考项目/
